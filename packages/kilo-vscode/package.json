{
  "name": "harness-code",
  "displayName": "Harness Code: AI Coding Agent with Step-by-Step Harness",
  "description": "Open source AI coding agent. Define a step-by-step harness of agents, command checks and AI-scored review, choose a model for each step, and approve the result yourself.",
  "version": "7.8.3",
  "icon": "assets/icons/harness-logo.png",
  "galleryBanner": {
    "color": "#FFFFFF",
    "theme": "light"
  },
  "publisher": "yuta-u-tech",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuta-u-tech/kilocode.git",
    "directory": "packages/kilo-vscode"
  },
  "engines": {
    "vscode": "^1.105.1"
  },
  "license": "MIT",
  "author": {
    "name": "Harness Code"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Education",
    "Snippets",
    "Testing"
  ],
  "keywords": [
    "kilo",
    "Harness Code",
    "kilocode",
    "ai",
    "agent",
    "agentic",
    "coding",
    "coding agent",
    "coding assistant",
    "autocomplete",
    "code completion",
    "pair programming",
    "chat",
    "terminal",
    "chatgpt",
    "claude",
    "sonnet",
    "anthropic",
    "openai",
    "zoo code",
    "opencode",
    "open code"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configurationDefaults": {
      "files.watcherExclude": {
        "**/.kilo/worktrees/**": true,
        "**/.kilocode/worktrees/**": true
      }
    },
    "taskDefinitions": [
      {
        "type": "kilo-worktree-setup",
        "properties": {
          "script": {
            "type": "string",
            "description": "The setup script command to execute"
          },
          "worktree": {
            "type": "string",
            "description": "The worktree directory the setup script runs in"
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "harness-code-ActivityBar",
          "title": "Harness Code",
          "icon": "assets/icons/harness-light.svg"
        }
      ]
    },
    "views": {
      "harness-code-ActivityBar": [
        {
          "type": "webview",
          "id": "harness-code.SidebarProvider",
          "name": "Harness Code"
        }
      ]
    },
    "commands": [
      {
        "command": "harness-code.plusButtonClicked",
        "title": "New Task",
        "category": "Harness Code",
        "icon": "$(add)"
      },
      {
        "command": "harness-code.closeTask",
        "title": "Close Task",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.closeAllTasks",
        "title": "Close All Tasks",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManagerOpen",
        "title": "Agent Manager",
        "category": "Harness Code",
        "icon": "$(organization)"
      },
      {
        "command": "harness-code.historyButtonClicked",
        "title": "History",
        "category": "Harness Code",
        "icon": "$(history)"
      },
      {
        "command": "harness-code.settingsButtonClicked",
        "title": "Settings",
        "category": "Harness Code",
        "icon": "$(settings-gear)"
      },
      {
        "command": "harness-code.sidebarTitle.plusButtonClicked",
        "title": "New Task",
        "icon": "$(add)"
      },
      {
        "command": "harness-code.sidebarTitle.agentManagerOpen",
        "title": "Agent Manager",
        "icon": "$(organization)"
      },
      {
        "command": "harness-code.sidebarTitle.historyButtonClicked",
        "title": "History",
        "icon": "$(history)"
      },
      {
        "command": "harness-code.sidebarTitle.settingsButtonClicked",
        "title": "Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "harness-code.openInTab",
        "title": "Open in Tab",
        "category": "Harness Code",
        "icon": {
          "light": "assets/icons/harness-light.svg",
          "dark": "assets/icons/harness-dark.svg"
        }
      },
      {
        "command": "harness-code.showChanges",
        "title": "Show Changes",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.showMemory",
        "title": "Show Project Memory",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.toggleMemory",
        "title": "Toggle Project Memory",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.toggleCaffeination",
        "title": "Toggle Keep Awake",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.autocomplete.generateSuggestions",
        "title": "Generate Suggested Edits",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.autocomplete.cancelSuggestions",
        "title": "Cancel Suggested Edits",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.autocomplete.nextEdit.acceptOrJump",
        "title": "Next Edit: Accept or Jump to Suggested Edit",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.autocomplete.nextEdit.dismiss",
        "title": "Next Edit: Dismiss Pending Suggestion",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.previousSession",
        "title": "Agent Manager: Previous Session",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.nextSession",
        "title": "Agent Manager: Next Session",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.previousTab",
        "title": "Agent Manager: Previous Tab",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.nextTab",
        "title": "Agent Manager: Next Tab",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.previousTerminal",
        "title": "Agent Manager: Previous Terminal",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.nextTerminal",
        "title": "Agent Manager: Next Terminal",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.diagnostics",
        "title": "Agent Manager: Show Worktree Diagnostics",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.search",
        "title": "Agent Manager: Search Worktrees and Sessions",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.showTerminal",
        "title": "Agent Manager: Focus Terminal",
        "category": "Harness Code",
        "icon": "$(terminal)"
      },
      {
        "command": "harness-code.agentManager.runScript",
        "title": "Agent Manager: Run Script",
        "category": "Harness Code",
        "icon": "$(play)"
      },
      {
        "command": "harness-code.agentManager.toggleDiff",
        "title": "Agent Manager: Toggle Diff Panel",
        "category": "Harness Code",
        "icon": "$(diff)"
      },
      {
        "command": "harness-code.agentManager.showShortcuts",
        "title": "Agent Manager: Show Keyboard Shortcuts",
        "category": "Harness Code",
        "icon": "$(keyboard)"
      },
      {
        "command": "harness-code.agentManager.newTab",
        "title": "Agent Manager: New Tab",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.newTerminalTab",
        "title": "Agent Manager: New Terminal Tab",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.newSideTerminal",
        "title": "Agent Manager: New Sidebar Terminal Tab",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.closeTab",
        "title": "Agent Manager: Close Tab",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.newWorktree",
        "title": "Agent Manager: Configure New Worktree",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.quickWorktree",
        "title": "Agent Manager: New Worktree",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.openWorktree",
        "title": "Agent Manager: Open Worktree",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.updateFromBase",
        "title": "Agent Manager: Update from base",
        "category": "Harness Code",
        "enablement": "activeWebviewPanelId == 'harness-code.AgentManagerPanel'"
      },
      {
        "command": "harness-code.agentManager.openPR",
        "title": "Agent Manager: Open Pull Request",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.closeWorktree",
        "title": "Agent Manager: Close Worktree",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.advancedWorktree",
        "title": "Agent Manager: Configure New Worktree",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.jumpTo1",
        "title": "Agent Manager: Jump to Item 1",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.jumpTo2",
        "title": "Agent Manager: Jump to Item 2",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.jumpTo3",
        "title": "Agent Manager: Jump to Item 3",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.jumpTo4",
        "title": "Agent Manager: Jump to Item 4",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.jumpTo5",
        "title": "Agent Manager: Jump to Item 5",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.jumpTo6",
        "title": "Agent Manager: Jump to Item 6",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.jumpTo7",
        "title": "Agent Manager: Jump to Item 7",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.jumpTo8",
        "title": "Agent Manager: Jump to Item 8",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.agentManager.jumpTo9",
        "title": "Agent Manager: Jump to Item 9",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "Harness Code",
        "icon": {
          "light": "assets/icons/harness-light.svg",
          "dark": "assets/icons/harness-dark.svg"
        }
      },
      {
        "command": "harness-code.explainCode",
        "title": "Explain Code",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.fixCode",
        "title": "Fix Code",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.improveCode",
        "title": "Improve Code",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.addToContext",
        "title": "Add to Context",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.terminalAddToContext",
        "title": "Add Terminal Content to Context",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.terminalFixCommand",
        "title": "Fix This Command",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.terminalExplainCommand",
        "title": "Explain This Command",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.focusChatInput",
        "title": "Focus Chat Input",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.toggleChatSearch",
        "title": "Toggle Chat Search",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.cycleAgentMode",
        "title": "Cycle Agent Mode",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.cyclePreviousAgentMode",
        "title": "Cycle Previous Agent Mode",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.toggleAutoApprove",
        "title": "Toggle Auto-Approve",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.generateTerminalCommand",
        "title": "Generate Terminal Command",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.takeHeapSnapshot",
        "title": "Take Heap Snapshot",
        "category": "Harness Code"
      },
      {
        "command": "harness-code.reload",
        "title": "Reload Config and Skills",
        "category": "Harness Code"
      }
    ],
    "submenus": [
      {
        "id": "harness-code.editorContextMenu",
        "label": "Harness Code"
      },
      {
        "id": "harness-code.terminalContextMenu",
        "label": "Harness Code"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "harness-code.sidebarTitle.plusButtonClicked",
          "when": "false"
        },
        {
          "command": "harness-code.sidebarTitle.historyButtonClicked",
          "when": "false"
        },
        {
          "command": "harness-code.sidebarTitle.agentManagerOpen",
          "when": "false"
        },
        {
          "command": "harness-code.agentManager.advancedWorktree",
          "when": "false"
        },
        {
          "command": "harness-code.sidebarTitle.settingsButtonClicked",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "harness-code.sidebarTitle.plusButtonClicked",
          "group": "navigation@0",
          "when": "view == harness-code.SidebarProvider && !harness-code.isCursor"
        },
        {
          "command": "harness-code.sidebarTitle.historyButtonClicked",
          "group": "navigation@1",
          "when": "view == harness-code.SidebarProvider && !harness-code.isCursor"
        },
        {
          "command": "harness-code.sidebarTitle.agentManagerOpen",
          "group": "navigation@2",
          "when": "view == harness-code.SidebarProvider && !harness-code.isCursor"
        },
        {
          "command": "harness-code.sidebarTitle.settingsButtonClicked",
          "group": "navigation@5",
          "when": "view == harness-code.SidebarProvider && !harness-code.isCursor"
        }
      ],
      "scm/title": [
        {
          "command": "harness-code.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "scm/input": [
        {
          "command": "harness-code.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "editor/title": [
        {
          "command": "harness-code.openInTab",
          "group": "navigation",
          "when": "true"
        },
        {
          "command": "harness-code.plusButtonClicked",
          "group": "navigation@0",
          "when": "activeWebviewPanelId == harness-code.TabPanel && !harness-code.isCursor"
        },
        {
          "command": "harness-code.historyButtonClicked",
          "group": "navigation@1",
          "when": "activeWebviewPanelId == harness-code.TabPanel && !harness-code.isCursor"
        },
        {
          "command": "harness-code.settingsButtonClicked",
          "group": "navigation@3",
          "when": "activeWebviewPanelId == harness-code.TabPanel && !harness-code.isCursor"
        }
      ],
      "editor/context": [
        {
          "submenu": "harness-code.editorContextMenu",
          "group": "1_kilocode"
        }
      ],
      "harness-code.editorContextMenu": [
        {
          "command": "harness-code.explainCode",
          "group": "1_actions@1"
        },
        {
          "command": "harness-code.fixCode",
          "group": "1_actions@2"
        },
        {
          "command": "harness-code.improveCode",
          "group": "1_actions@3"
        },
        {
          "command": "harness-code.addToContext",
          "group": "1_actions@4"
        }
      ],
      "terminal/context": [
        {
          "submenu": "harness-code.terminalContextMenu",
          "group": "2_kilocode"
        }
      ],
      "harness-code.terminalContextMenu": [
        {
          "command": "harness-code.terminalAddToContext",
          "group": "1_actions@1"
        },
        {
          "command": "harness-code.terminalFixCommand",
          "group": "1_actions@2"
        },
        {
          "command": "harness-code.terminalExplainCommand",
          "group": "1_actions@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "harness-code.focusChatInput",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "harness-code.toggleAutoApprove",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "harness-code.generateTerminalCommand",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g"
      },
      {
        "command": "-workbench.actions.view.problems",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "harness-code.agentManagerOpen",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "harness-code.addToContext",
        "key": "ctrl+k ctrl+a",
        "mac": "cmd+k cmd+a",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "harness-code.agentManager.previousSession",
        "key": "ctrl+alt+up",
        "mac": "cmd+alt+up",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel'"
      },
      {
        "command": "harness-code.agentManager.nextSession",
        "key": "ctrl+alt+down",
        "mac": "cmd+alt+down",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel'"
      },
      {
        "command": "harness-code.agentManager.previousTab",
        "key": "ctrl+alt+left",
        "mac": "cmd+alt+left",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel'"
      },
      {
        "command": "harness-code.agentManager.nextTab",
        "key": "ctrl+alt+right",
        "mac": "cmd+alt+right",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel'"
      },
      {
        "command": "harness-code.agentManager.previousTerminal",
        "key": "ctrl+shift+[",
        "mac": "cmd+shift+[",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel'"
      },
      {
        "command": "harness-code.agentManager.nextTerminal",
        "key": "ctrl+shift+]",
        "mac": "cmd+shift+]",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel'"
      },
      {
        "command": "harness-code.agentManager.search",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel' && !terminalFocus"
      },
      {
        "command": "harness-code.agentManager.showTerminal",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel' && !harness-code.sidebarFocused"
      },
      {
        "command": "harness-code.agentManager.runScript",
        "key": "ctrl+e",
        "mac": "cmd+e",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel' && (isMac || !terminalFocus)"
      },
      {
        "command": "harness-code.agentManager.toggleDiff",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel'"
      },
      {
        "command": "harness-code.agentManager.showShortcuts",
        "key": "ctrl+shift+/",
        "mac": "cmd+shift+/",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel'"
      },
      {
        "command": "harness-code.agentManager.newTab",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel' && !harness-code.agentManagerSideTerminalFocused"
      },
      {
        "command": "harness-code.agentManager.newTerminalTab",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel' && !harness-code.agentManagerSideTerminalFocused"
      },
      {
        "command": "harness-code.agentManager.newSideTerminal",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel' && harness-code.agentManagerSideTerminalFocused"
      },
      {
        "command": "harness-code.agentManager.closeTab",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel'"
      },
      {
        "command": "harness-code.agentManager.newWorktree",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel'"
      },
      {
        "command": "harness-code.agentManager.quickWorktree",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel'"
      },
      {
        "command": "harness-code.agentManager.openWorktree",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel'"
      },
      {
        "command": "harness-code.agentManager.openPR",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel'"
      },
      {
        "command": "harness-code.agentManager.closeWorktree",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel'"
      },
      {
        "command": "harness-code.agentManager.jumpTo1",
        "key": "ctrl+1",
        "mac": "cmd+1",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel'"
      },
      {
        "command": "harness-code.agentManager.jumpTo2",
        "key": "ctrl+2",
        "mac": "cmd+2",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel'"
      },
      {
        "command": "harness-code.agentManager.jumpTo3",
        "key": "ctrl+3",
        "mac": "cmd+3",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel'"
      },
      {
        "command": "harness-code.agentManager.jumpTo4",
        "key": "ctrl+4",
        "mac": "cmd+4",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel'"
      },
      {
        "command": "harness-code.agentManager.jumpTo5",
        "key": "ctrl+5",
        "mac": "cmd+5",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel'"
      },
      {
        "command": "harness-code.agentManager.jumpTo6",
        "key": "ctrl+6",
        "mac": "cmd+6",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel'"
      },
      {
        "command": "harness-code.agentManager.jumpTo7",
        "key": "ctrl+7",
        "mac": "cmd+7",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel'"
      },
      {
        "command": "harness-code.agentManager.jumpTo8",
        "key": "ctrl+8",
        "mac": "cmd+8",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel'"
      },
      {
        "command": "harness-code.agentManager.jumpTo9",
        "key": "ctrl+9",
        "mac": "cmd+9",
        "when": "activeWebviewPanelId == 'harness-code.AgentManagerPanel'"
      },
      {
        "command": "harness-code.cycleAgentMode",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "harness-code.sidebarFocused || activeWebviewPanelId == 'harness-code.AgentManagerPanel' || activeWebviewPanelId == 'harness-code.TabPanel'"
      },
      {
        "command": "harness-code.cyclePreviousAgentMode",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+.",
        "when": "harness-code.sidebarFocused || activeWebviewPanelId == 'harness-code.AgentManagerPanel' || activeWebviewPanelId == 'harness-code.TabPanel'"
      },
      {
        "command": "harness-code.autocomplete.cancelSuggestions",
        "key": "escape",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && harness-code.autocomplete.hasSuggestions"
      },
      {
        "command": "harness-code.autocomplete.generateSuggestions",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && kilocode.autocomplete.enableSmartInlineTaskKeybinding && !github.copilot.completions.enabled"
      },
      {
        "command": "harness-code.autocomplete.showIncompatibilityExtensionPopup",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && kilocode.autocomplete.enableSmartInlineTaskKeybinding && github.copilot.completions.enabled"
      },
      {
        "command": "harness-code.autocomplete.nextEdit.acceptOrJump",
        "key": "tab",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && !suggestWidgetVisible && kilo-code.nextEdit.hasPendingSuggestion"
      },
      {
        "command": "harness-code.autocomplete.nextEdit.dismiss",
        "key": "escape",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && kilo-code.nextEdit.hasPendingSuggestion"
      }
    ],
